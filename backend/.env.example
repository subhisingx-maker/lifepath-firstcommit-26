# LIFEPATH backend settings.
# 1. Copy this file to a new file named ".env" in the same folder (backend/).
# 2. NEVER commit ".env" to GitHub. It is already listed in .gitignore.
#
# Leave GEMINI_API_KEY empty to run in DEMO MODE (no AI, everything else works).
# When you get a key from Google AI Studio, paste it after the "=" sign. No quotes needed.
GEMINI_API_KEY=

# Which AI provider to use. Only "gemini" is planned for now.
AI_PROVIDER=gemini
# Model name. Check Google's current model list and change this if needed.
GEMINI_MODEL=gemini-3.8-flash

# development or production
APP_ENV=development

# Upload limits
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=300

# Websites allowed to call this API (comma separated). Add your deployed frontend URL later.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database. Default is a SQLite file inside backend/. A PostgreSQL URL can replace it later.
# DATABASE_URL=sqlite:///C:/path/to/lifepath.db

# AI request settings
# Overall deadline in seconds for one Gemini request, including retries and backoff.
AI_TIMEOUT_SECONDS=120
# Max characters of notice text per AI request (long notices are split into batches).
# Temporary HTTP 429/5xx and network failures get up to 3 provider attempts, with exponential backoff and Retry-After.
# Timed-out or truncated batches are split once into two smaller halves by the extraction pipeline.
AI_BATCH_CHARS=24000
# Uploads allowed per minute per client (protects your Gemini quota)
AI_RATE_LIMIT_PER_MINUTE=10
